{
  "name": "todo-app",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && sed -i '' -E 's#(href|src)=\"/#\\1=\"./#g' dist/index.html && sed -i '' -E 's/ type=\"module\" crossorigin//g' dist/index.html && sed -i '' -E 's#\\./favicon\\.ico#./favicon.ico#g' dist/index.html",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "electron:serve": "electron .",
    "electron:build": "npm run build && electron-builder --dir",
    "dist": "electron-builder",
    "mobile:sync": "npx cap sync",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "mobile:build:ios": "npm run build && npx cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -archivePath ios/App.xcarchive archive && xcodebuild -exportArchive -archivePath ios/App.xcarchive -exportPath ios/App.ipa -exportOptionsPlist ios/exportOptions.plist",
    "mobile:build:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "release:all": "npm run build && npx cap sync && electron-builder",
    "release:local": "bash scripts/build-all.sh"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@vitejs/plugin-vue": "^2.2.2",
    "daisyui": "^3.1.0",
    "pinia": "^2.3.1",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.3.2",
    "vue": "^3.2.31",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.12.1",
    "@vue/compiler-sfc": "^3.2.31",
    "@vue/eslint-config-typescript": "^10.0.0",
    "autoprefixer": "^10.4.14",
    "babel-eslint": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.9.0",
    "eslint-plugin-vue": "^8.5.0",
    "postcss": "^8.4.23",
    "prettier": "^2.5.1",
    "typescript": "^4.5.5",
    "vite": "^2.8.4"
  },
  "build": {
    "appId": "com.todoapp.app",
    "productName": "Todo App",
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Todo-App-${version}-mac",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Todo-App-${version}-win.exe"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js",
      "config.json"
    ],
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": null
  },
  "description": "对标滴答清单的个人任务管理工具",
  "author": "Todo App Team"
}
